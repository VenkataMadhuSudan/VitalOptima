# VitalOptima Environment Configuration Template
# Copy this file to .env and configure your PostgreSQL connection string:
# cp .env.example .env

# PostgreSQL Database Connection URL (e.g., Neon Cloud or Local PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql://username:password@ep-sample-project.c-3.aws.neon.tech/neondb?sslmode=require

# Application Settings
APP_ENV=production
APP_PORT=8501
HOSPITAL_NAME="City General Hospital"

# Google Gemini API Key (Optional for Unlimited Generative What-If Reasoning)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
